{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.phlohouse.com/schema/descriptor.v1.json",
  "title": "Phlo Provider Descriptor Claim (Authority A, ADR 0053)",
  "description": "Static, self-describing publisher claim. Checkable without executing provider code; may support the community tier and nothing above it. The field set is closed: no tier, support, verified, or conformance field is expressible (ADR 0053 concern 3).",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "package", "version", "description", "author", "tags"],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "source",
        "quality",
        "transform",
        "service",
        "assets",
        "resources",
        "resource",
        "source_connectors",
        "quality_checks",
        "quality_providers",
        "ingestion_providers",
        "transformation_providers",
        "transformations",
        "services",
        "cli_commands",
        "hooks",
        "asset_providers",
        "resource_providers",
        "orchestrators",
        "catalogs"
      ]
    },
    "package": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "description": "Accountable publisher identity: the upstream maintainer or organization, never a placeholder."
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "core": {
      "type": "boolean",
      "description": "Blessed in-repo provenance only; marks discovery/defaulting roles, never release maturity."
    }
  }
}
