#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
observatory_dir="$repo_root/packages/phlo-observatory/src/phlo_observatory"

run_step() {
  local label="$1"
  shift
  echo "==> $label"
  time "$@"
}

install_uv() {
  if ! command -v uv >/dev/null 2>&1 || [[ "$(uv --version | awk '{print $2}')" != "0.12.1" ]]; then
    curl -LsSf https://astral.sh/uv/0.12.1/install.sh | sh
  fi
}

install_node() {
  local node_version node_root archive architecture
  node_version="v24.6.0"
  node_root="$HOME/.local/share/nodejs/node-$node_version"

  if [[ ! -x "$node_root/bin/node" ]]; then
    case "$(uname -m)" in
      x86_64) architecture="x64" ;;
      aarch64|arm64) architecture="arm64" ;;
      *) echo "Unsupported architecture for Node.js: $(uname -m)" >&2; return 1 ;;
    esac
    archive="node-$node_version-linux-$architecture.tar.xz"
    mkdir -p "$node_root"
    curl -LsSf "https://nodejs.org/dist/$node_version/$archive" |
      tar -xJ --strip-components=1 -C "$node_root"
  fi

  export PATH="$node_root/bin:$PATH"

  local marker="# phlo orb Node.js"
  if ! grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null; then
    cat >> "$HOME/.bash_profile" <<EOF

$marker
if [[ "\${PWD}" == "$repo_root" || "\${PWD}" == "$repo_root/"* ]]; then
  export PATH="$node_root/bin:\$PATH"
fi
EOF
  fi
}

cd "$repo_root"
run_step "Install uv 0.12.1" install_uv
export PATH="$HOME/.local/bin:$PATH"
run_step "Install Python 3.11" uv python install 3.11
run_step "Sync Python workspace" uv sync --python 3.11 --dev --locked
run_step "Install Node.js 24" install_node
run_step "Sync Observatory dependencies" npm ci --prefix "$observatory_dir"

echo "Orb setup complete."
