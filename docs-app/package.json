{
  "name": "phlo-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "node ./scripts/sync-docs.mjs && next build",
    "dev": "node ./scripts/sync-docs.mjs && next dev --port 3101",
    "start": "serve out",
    "typecheck": "node ./scripts/sync-docs.mjs && fumadocs-mdx && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "beautiful-mermaid": "^1.1.3",
    "fumadocs-core": "16.7.7",
    "fumadocs-mdx": "14.2.11",
    "fumadocs-ui": "16.7.7",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.8",
    "serve": "^14.2.6",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2"
  }
}
