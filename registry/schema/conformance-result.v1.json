{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.phlohouse.com/schema/conformance-result.v1.json",
  "title": "Phlo Conformance Result (Authority B shape, ADR 0053)",
  "description": "Static shape of a Phlo-owned conformance record. The record itself can only be authored by the phlo-conformance runner on Phlo-owned infrastructure; this schema only makes the stored shape strictly checkable. The tracer enum is closed: query_engine.v1 is the only approved tracer (ADR 0053 concern 7).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject",
    "tracer",
    "result",
    "evidence_refs",
    "executed_by",
    "run_at",
    "expires_at"
  ],
  "properties": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "digest"],
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "tracer": {
      "type": "string",
      "enum": ["query_engine.v1"]
    },
    "result": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Durable evidence record ids in the ADR 0048 store. A verdict without resolvable references is invalid and treated as absent."
    },
    "executed_by": {
      "type": "string",
      "const": "phlo-conformance"
    },
    "run_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
