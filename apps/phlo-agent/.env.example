# Required for local model calls. A linked Vercel deployment uses OIDC instead.
AI_GATEWAY_API_KEY=

# Optional model overrides.
PHLO_AGENT_MODEL=deepseek/deepseek-v4-flash
PHLO_AGENT_VISION_MODEL=alibaba/qwen3.7-flash

# The GitHub App name selected while provisioning the Vercel Connect channel.
PHLO_AGENT_GITHUB_BOT=phlo-agent
